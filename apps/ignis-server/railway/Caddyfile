# Rendered by railway/entrypoint.sh's env; Caddy substitutes {$VAR} at load.
{
	admin off
	auto_https off
}

:{$CADDY_PORT} {
	# Unauthenticated so Railway's health check can reach it; reports whether Ignis answers.
	handle /healthz {
		rewrite * /
		reverse_proxy 127.0.0.1:{$IGNIS_PORT}
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:{$IGNIS_PORT}
	}
}
